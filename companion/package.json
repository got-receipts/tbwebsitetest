{
  "name": "thunderbuddies-companion",
  "version": "1.0.0",
  "description": "Thunder Buddies Studios desktop companion for Discord Rich Presence.",
  "main": "main.js",
  "author": "Thunder Buddies Studios",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thunderbuddies.companion",
    "productName": "Thunder Buddies Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "renderer.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "ThunderBuddiesCompanion.exe"
    }
  }
}
